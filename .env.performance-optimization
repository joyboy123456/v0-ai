# 4C8G / 单 Next.js 进程的安全起步值。
# 生产使用时复制到 .env.local，不要在本文件写入真实密钥。

# 全站公平调度：5 个用户共享 12 个执行槽位，每用户最多 3 个。
IMAGE_GLOBAL_CONCURRENCY=12
IMAGE_PER_USER_CONCURRENCY=3
IMAGE_QUEUE_MAX_PENDING=200

# 当前只有“老张”一个上游渠道，上游未限制本项目并发。
# IMAGE_PROVIDERS 中的 6 个老张项只是逻辑入口，不代表 6 个独立渠道或 6 倍配额。
# 每个逻辑入口最多 2 个在途，6 个入口合计与全局 12 槽位对齐。
IMAGE_PER_PROVIDER_CONCURRENCY=2

# 业务内层并发不能绕过全局调度器。
PHOTO_FISSION_CONCURRENCY=4
POSE_FISSION_CONCURRENCY=2

# 老张逻辑入口的实际 JSON 配置由生产环境注入；不要在 Git 中保存 apiKey。
# 保留现有 6 个 type="laozhang" 配置，并为每个配置设置 maxConcurrency=2。
# IMAGE_PROVIDERS=<由生产环境注入的 6 个老张逻辑入口 JSON>

# 单次老张请求先在 IMAGE_PROVIDERS 每个项中设 timeoutMs=120000，
# 再根据容量接口和实际 P95 延迟调整。
