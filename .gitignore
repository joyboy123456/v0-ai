.env
.env.local
.env*.local
.env.local.*

# 含 bcrypt 密码 hash 的 seed SQL（每次 hash 不同，不入仓库）
migrations/*_seed_*.sql

# Common ignores
node_modules
.next/
*.tsbuildinfo
.DS_Store

# Runtime generated assets and local task metadata
data/
public/generated/
# Probe / capability research artifacts
.probe/
.probe-*.json

# 研究参考资料（121M 浅克隆，仅供 implement 参考，不入版本控制）
.trellis/tasks/*/research/yibaiaigc/
# Runtime logs
logs/

# Env backups (contain secrets)
